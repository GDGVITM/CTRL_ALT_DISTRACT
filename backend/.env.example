# Backend (FastAPI). Copy to backend/.env — that file is gitignored and holds secrets.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
# Only needed if the project still signs tokens with the legacy HS256 secret
# (Dashboard -> Project Settings -> API -> JWT Settings). Modern projects use JWKS and need nothing here.
SUPABASE_JWT_SECRET=

# --- Postgres ---------------------------------------------------------------------------------
# Use the *session pooler* string (Dashboard -> Connect -> Session pooler). The direct host
# db.<ref>.supabase.co is IPv6-only and does not resolve on many networks.
# URL-encode special characters in the password ('@' -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Judge0 -----------------------------------------------------------------------------------
# Public community instance (rate limited; fine for development and small events).
JUDGE0_URL=https://ce.judge0.com
# For a hosted/self-hosted instance with auth, set the key and header name it expects:
#   Judge0 CE self-hosted:  JUDGE0_API_KEY=<token>   JUDGE0_API_KEY_HEADER=X-Auth-Token
#   RapidAPI:               JUDGE0_API_KEY=<key>     JUDGE0_API_KEY_HEADER=X-RapidAPI-Key  JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=X-Auth-Token
JUDGE0_API_HOST=
# Simultaneous judge calls issued by this process (keep within your Judge0 worker capacity).
JUDGE0_CONCURRENCY=8
